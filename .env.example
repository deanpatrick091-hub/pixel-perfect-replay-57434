# ---- Market worker (set these on your worker host: Railway / Fly.io / Render) ----
PORT=8787
# Public HTTPS URL of this worker, e.g. https://memeterm-worker.up.railway.app
PUBLIC_URL=
# Your Lovable site URL(s), comma separated, for browser CORS / WebSocket origin checks
ALLOWED_ORIGINS=https://id-preview--05c8e19c-2db3-4f33-896c-0f9126c1b9fe.lovable.app
# Where the worker sends market state (your site + /api/public/worker-ingest)
INGEST_URL=https://id-preview--05c8e19c-2db3-4f33-896c-0f9126c1b9fe.lovable.app/api/public/worker-ingest
# Must equal the WORKER_INGEST_SECRET saved in Lovable (at least 24 characters)
WORKER_INGEST_SECRET=replace-with-the-same-long-random-string
# Optional: PumpPortal API key enables metered live trade subscriptions
PUMPPORTAL_API_KEY=
# Max concurrent subscribeTokenTrade mints (each trade message is metered by PumpPortal)
MAX_TRADE_SUBSCRIPTIONS=40
# Metered per-token trade feed. Keep false until you deliberately enable it (needs a funded PUMPPORTAL_API_KEY).
ENABLE_TRADE_SUBSCRIPTIONS=false
# Curve progress (0..1) at which a market moves to Final Stretch
FINAL_STRETCH_THRESHOLD=0.7
