# ---- Market worker (set these on your worker host: Railway / Fly.io / Render) ----
PORT=8787
# Public HTTPS URL of this worker, e.g. https://memeterm-worker.up.railway.app
PUBLIC_URL=
# Your Lovable site URL(s), comma separated, for browser CORS / WebSocket origin checks
ALLOWED_ORIGINS=https://your-published-site.example
# Use your PUBLIC published site, not a protected Lovable preview/editor URL.
# Where the worker sends market state (your site + /api/public/worker-ingest)
INGEST_URL=https://your-published-site.example/api/public/worker-ingest
# Must equal the WORKER_INGEST_SECRET saved in Lovable (at least 24 characters)
WORKER_INGEST_SECRET=replace-with-the-same-long-random-string
# Optional: PumpPortal API key enables metered live trade subscriptions
PUMPPORTAL_API_KEY=
# Max concurrent subscribeTokenTrade mints (each trade message is metered by PumpPortal)
MAX_TRADE_SUBSCRIPTIONS=40
# Explicit opt-in to metered trades; a funded key alone does not enable them.
# Keep false for free, read-only on-chain charts.
ENABLE_TRADE_SUBSCRIPTIONS=false
# Curve progress (0..1) at which a market moves to Final Stretch
FINAL_STRETCH_THRESHOLD=0.7
# Chart history (read-only): Solana JSON-RPC. Defaults to the free public mainnet endpoint.
SOLANA_RPC_URL=
# Global request budget for chart history (requests/second); slows automatically after rate limits
SOLANA_RPC_MAX_RPS=2
SOLANA_RPC_TIMEOUT_MS=15000
# Free live trade hints (logsSubscribe) for viewed curves; defaults to the RPC URL with ws(s)://
SOLANA_WS_URL=
SOLANA_WS_ENABLED=true
SOLANA_WS_MAX_SUBS=5
